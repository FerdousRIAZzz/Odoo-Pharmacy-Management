<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharmacy_medicine_batch_form" model="ir.ui.view">
        <field name="name">pharmacy.medicine.batch.form</field>
        <field name="model">pharmacy.medicine.batch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="medicine_id"/>
                        <field name="batch_number"/>
                        <field name="expiry_date"/>
                        <field name="quantity"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pharmacy_medicine_batch_list" model="ir.ui.view">
        <field name="name">pharmacy.medicine.batch.list</field>
        <field name="model">pharmacy.medicine.batch</field>
        <field name="arch" type="xml">
            <!-- Two independent decorations: red row if already expired,
                 orange row if expiring within 30 days -->
            <list decoration-danger="is_expired" decoration-warning="is_near_expiry">
                <field name="medicine_id"/>
                <field name="batch_number"/>
                <field name="expiry_date"/>
                <field name="quantity"/>
                <field name="is_expired" column_invisible="1"/>
                <field name="is_near_expiry" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_pharmacy_medicine_batch_search" model="ir.ui.view">
        <field name="name">pharmacy.medicine.batch.search</field>
        <field name="model">pharmacy.medicine.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="medicine_id"/>
                <field name="batch_number"/>
                <filter string="Expired" name="filter_expired"
                        domain="[('is_expired', '=', True)]"/>
                <filter string="Near Expiry" name="filter_near_expiry"
                        domain="[('is_near_expiry', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_pharmacy_medicine_batch" model="ir.actions.act_window">
        <field name="name">Batches</field>
        <field name="res_model">pharmacy.medicine.batch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pharmacy_medicine_batch_search"/>
    </record>
</odoo>
